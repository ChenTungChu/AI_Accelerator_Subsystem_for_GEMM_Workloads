# ------------------------------------------------------------
# Smoke test (primary host path)
# ------------------------------------------------------------
ai_accel_subsys_smoke_test CASE_ID 5   +ENABLE_RESULT_CHECK=1
ai_accel_subsys_smoke_test CASE_ID 100 +ENABLE_RESULT_CHECK=1
ai_accel_subsys_smoke_test CASE_ID 101 +ENABLE_RESULT_CHECK=1
ai_accel_subsys_smoke_test CASE_ID 105 +ENABLE_RESULT_CHECK=1
ai_accel_subsys_smoke_test CASE_ID 400 +ENABLE_RESULT_CHECK=1
ai_accel_subsys_smoke_test CASE_ID 401 +ENABLE_RESULT_CHECK=1
ai_accel_subsys_smoke_test CASE_ID 402 +ENABLE_RESULT_CHECK=1
ai_accel_subsys_smoke_test CASE_ID 403 +ENABLE_RESULT_CHECK=1


# ------------------------------------------------------------
# DMA load smoke / error / stress / CDC
# ------------------------------------------------------------
ai_accel_subsys_dma_load_smoke_test CASE_ID 100 +RUN_ALL=1 +ENABLE_RESULT_CHECK=1
ai_accel_subsys_dma_load_error_test +ENABLE_RESULT_CHECK=0
ai_accel_subsys_dma_load_stress_test +ENABLE_RESULT_CHECK=1 +STRESS_JOB_COUNT=8 +STRESS_SEED=20260502 +STRESS_RANDOM=1 +STRESS_GAP_CYCLES=10
ai_accel_subsys_dma_load_stress_test +ENABLE_RESULT_CHECK=1 +STRESS_JOB_COUNT=8 +STRESS_SEED=20260502 +STRESS_RANDOM=1 +STRESS_GAP_CYCLES=10 +DMA_CLK_PERIOD_NS=10 +CORE_CLK_PERIOD_NS=13


# ------------------------------------------------------------
# DMA store / S2MM smoke / error / load-store stress
# ------------------------------------------------------------
ai_accel_subsys_dma_store_smoke_test +RUN_ALL=1 +ENABLE_RESULT_CHECK=1
ai_accel_subsys_dma_store_error_test +ENABLE_RESULT_CHECK=0
ai_accel_subsys_dma_load_store_stress_test +ENABLE_RESULT_CHECK=1 +STORE_STRESS_JOB_COUNT=8 +STORE_STRESS_SEED=20260502 +STORE_STRESS_RANDOM=1 +STORE_STRESS_GAP_CYCLES=10


