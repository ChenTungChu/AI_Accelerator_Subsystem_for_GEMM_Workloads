# ------------------------------------------------------------
# P11 N-tiling representative regression
#
# These are directed single-case items. They keep the default
# stress pools unchanged and force one representative CASE_ID=200
# job per frontend path.
#
# CASE_ID=200: M=4, N=16, K=16.
#   - K tiling: 16 = 8 + 8
#   - N tiling: 16 = 8 + 8
#
# The long GEMM timeout is explicit-only and is needed because
# this representative combined K+N tiling case naturally exceeds
# the historical frontend smoke timeout.
# ------------------------------------------------------------
ai_accel_subsys_dma_load_store_stress_test CASE_ID 200 GEMM_MAC_LANES 4 GEMM_ENABLE_B_CACHE 1 GEMM_B_CACHE_MAX_K 8 GEMM_B_CACHE_MAX_N 8 GEMM_ENABLE_PACKED_BCACHE_PRELOAD 1 GEMM_ENABLE_A_ROW_CACHE 1 GEMM_A_ROW_CACHE_MAX_K 8 GEMM_ENABLE_PACKED_A_ROW_PRELOAD 1 GEMM_ENABLE_K_TILING 1 GEMM_K_TILE_SIZE 8 GEMM_ENABLE_N_TILING 1 GEMM_N_TILE_SIZE 8 +ENABLE_RESULT_CHECK=1 +STORE_STRESS_JOB_COUNT=1 +STORE_STRESS_SEED=20260502 +STORE_STRESS_RANDOM=0 +STORE_STRESS_GAP_CYCLES=10 +FORCE_HELPER_MEM_PATH=0 +DMA_CLK_PERIOD_NS=10 +CORE_CLK_PERIOD_NS=14 +SMOKE_DONE_TIMEOUT_CYCLES=100000
ai_accel_subsys_axis_stream_load_store_stress_test CASE_ID 200 GEMM_MAC_LANES 4 GEMM_ENABLE_B_CACHE 1 GEMM_B_CACHE_MAX_K 8 GEMM_B_CACHE_MAX_N 8 GEMM_ENABLE_PACKED_BCACHE_PRELOAD 1 GEMM_ENABLE_A_ROW_CACHE 1 GEMM_A_ROW_CACHE_MAX_K 8 GEMM_ENABLE_PACKED_A_ROW_PRELOAD 1 GEMM_ENABLE_K_TILING 1 GEMM_K_TILE_SIZE 8 GEMM_ENABLE_N_TILING 1 GEMM_N_TILE_SIZE 8 +ENABLE_RESULT_CHECK=1 +AXIS_STRESS_JOB_COUNT=1 +AXIS_STRESS_SEED=20260502 +AXIS_STRESS_RANDOM=0 +AXIS_STRESS_GAP_CYCLES=10 +FORCE_HELPER_MEM_PATH=0 +DMA_CLK_PERIOD_NS=10 +CORE_CLK_PERIOD_NS=14 +SMOKE_DONE_TIMEOUT_CYCLES=100000
ai_accel_subsys_direct_stream_load_store_stress_test CASE_ID 200 GEMM_MAC_LANES 4 GEMM_ENABLE_B_CACHE 1 GEMM_B_CACHE_MAX_K 8 GEMM_B_CACHE_MAX_N 8 GEMM_ENABLE_PACKED_BCACHE_PRELOAD 1 GEMM_ENABLE_A_ROW_CACHE 1 GEMM_A_ROW_CACHE_MAX_K 8 GEMM_ENABLE_PACKED_A_ROW_PRELOAD 1 GEMM_ENABLE_K_TILING 1 GEMM_K_TILE_SIZE 8 GEMM_ENABLE_N_TILING 1 GEMM_N_TILE_SIZE 8 +ENABLE_RESULT_CHECK=1 +DS_STRESS_JOB_COUNT=1 +DS_STRESS_SEED=20260502 +DS_STRESS_RANDOM=0 +DS_STRESS_GAP_CYCLES=10 +FORCE_HELPER_MEM_PATH=0 +DMA_CLK_PERIOD_NS=10 +CORE_CLK_PERIOD_NS=14 +SMOKE_DONE_TIMEOUT_CYCLES=100000


